# Copy to .env and adjust as needed.

# Folder with source documents (.md, .txt, .pdf)
MEDRAG_DATA_DIR=data/raw
# Where the vector index is persisted
MEDRAG_INDEX_DIR=storage/index
# Downloaded open datasets (MedQuAD, LiveQA)
MEDRAG_EXTERNAL_DIR=data/external
# Knowledge sources to index: "local" (data/raw), "medquad", or both
MEDRAG_SOURCES=local,medquad

# "sentence-transformers" (default) or "hashing" (offline, no model download)
MEDRAG_EMBEDDING_BACKEND=sentence-transformers
MEDRAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

MEDRAG_CHUNK_SIZE=800
MEDRAG_CHUNK_OVERLAP=120
MEDRAG_TOP_K=5
# "hybrid", "dense" or "sparse"
MEDRAG_RETRIEVAL_MODE=hybrid

# Cross-encoder re-ranking of the top candidates
MEDRAG_RERANK=true
MEDRAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MEDRAG_RERANK_CANDIDATES=30

# Phase 2 (LLM generation) - not used yet
# LLM_PROVIDER=
# LLM_API_KEY=
